; Engine configuration file.
; BMS Carrom — original carrom board game (Godot 4.3).
; Working title "BMS Carrom". Package com.musehiro.carrom.

config_version=5

[application]

config/name="BMS Carrom"
config/description="Play real carrom online or offline. Real physics, fair matches, fewer ads."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
; BMS boot splash at launch: big gold BMS on black, never the Godot logo.
boot_splash/bg_color=Color(0.063, 0.051, 0.039, 1)
boot_splash/image="res://art/bms_splash.png"
boot_splash/fullsize=true
boot_splash/minimum_display_time=500

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Graphics upgrade (2026-11-26): the board is drawn in 2D canvas, so the
; 3D-only parts of Grok's plan do not apply here. MSAA 2D is NOT supported
; by the Compatibility renderer (Forward+/Mobile only) - edge smoothing
; is done with antialiased=true on the canvas draw calls in
; scripts/board_view.gd instead. The renderer stays gl_compatibility
; for the widest low-end Android support; do not switch it for this game.
textures/vram_compression/import_etc2_astc=true

[autoload]

Save="*res://scripts/save_data.gd"
Ads="*res://scripts/ads.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net_client.gd"
Supabase="*res://scripts/supabase.gd"
Accounts="*res://scripts/accounts.gd"
Friends="*res://scripts/friends.gd"
GodotPlayGameServices="*res://addons/GodotPlayGameServices/scripts/autoloads/godot_play_game_services.gd"
PlayGames="*res://scripts/play_games.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/bin_decode/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")
