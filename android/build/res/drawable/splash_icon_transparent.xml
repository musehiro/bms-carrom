<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent 1x1 dp icon for the Android 12+ system splash
     (Google sign-in + splash fix, 2026-11-27): the game shows NO
     icon on the system splash — the dark background blends straight
     into the engine boot splash (the game's own loading art).
     Referenced by android/build/res/values/themes.xml
     (windowSplashScreenAnimatedIcon). Tracked in git and restored
     by the CI "Restore tracked Android customizations" step. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
	<solid android:color="@android:color/transparent" />
	<size android:width="1dp" android:height="1dp" />
</shape>
